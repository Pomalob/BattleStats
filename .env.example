# Postgres connection string. Neon: Dashboard -> Connection string -> psql
DATABASE_URL=postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/battlestats

# Signs the JWT session tokens. At least 32 characters; required when ENV=production.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# development | production. Production refuses to start without a strong SECRET_KEY.
ENV=development

# Optional limits (defaults shown)
# TOKEN_TTL_DAYS=30
# MAX_FILES_PER_UPLOAD=200
# MAX_FILE_SIZE=10485760
# MAX_UPLOAD_SIZE=157286400
# DB_POOL_MAX=5
# LOGIN_MAX_ATTEMPTS=10
# LOGIN_LOCKOUT_SECONDS=300
